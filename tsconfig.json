{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "jest"
        ],
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@elizaos/core/*": [
                "./packages/core/*"
            ],
            "@elizaos/*": [
                "./packages/*"
            ]
        }
    },
    "files": [],
    "references": [
        {
            "path": "packages/core"
        }
    ],
    "exclude": [
        "**/dist",
        "**/*.d.ts",
        "**/__tests__",
        "node_modules",
        "**/node_modules"
    ]
}