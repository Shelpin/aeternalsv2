{
    "compilerOptions": {
        "target": "es2022",
        "module": "ESNext",
        "lib": [
            "es2022",
            "dom"
        ],
        "moduleResolution": "Bundler",
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "isolatedModules": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "dist",
        "**/*.test.ts",
        "node_modules"
    ]
}