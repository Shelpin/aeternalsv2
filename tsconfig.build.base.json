{
    "compilerOptions": {
        "target": "ES2021",
        "module": "nodenext",
        "lib": [
            "es2021",
            "dom"
        ],
        "moduleResolution": "nodenext",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "rootDir": "./src"
    },
    "exclude": [
        "dist",
        "**/*.test.ts",
        "node_modules"
    ]
}