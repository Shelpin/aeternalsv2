{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "composite": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "types": [
            "node",
            "jest"
        ],
        "paths": {
            "@elizaos/*": [
                "./packages/*"
            ]
        }
    },
    "exclude": [
        "**/dist",
        "**/*.test.ts",
        "**/__tests__/**",
        "**/node_modules"
    ]
}