{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "noEmitOnError": false,
    "noImplicitAny": false,
    "strict": false,
    "sourceMap": true,
    "paths": {
      "@elizaos/types": [
        "../types/dist"
      ],
      "@elizaos/types/*": [
        "../types/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/__tests__/**/*",
    "src/test_resources/**/*"
  ],
  "references": [
    {
      "path": "../types"
    }
  ]
}