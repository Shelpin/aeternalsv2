{
  "name": "@elizaos/core",
  "version": "0.25.9",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./public-api": {
      "types": "./dist/public-api.d.ts",
      "import": "./dist/public-api.js",
      "require": "./dist/public-api.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist && find . -name '*.d.ts' -o -name '*.ts' | grep dist | xargs rm -f 2>/dev/null || true",
    "build": "tsup && tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json",
    "build:full": "pnpm build",
    "clean": "rimraf dist",
    "dev": "tsup --format esm,cjs --watch",
    "build:docs": "cd docs && pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:types": "madge --circular --extensions ts ./src/api",
    "check:full": "madge --circular --extensions ts ./src"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.8.4",
    "rimraf": "^6.0.1",
    "tsup": "8.3.5",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "1.1.6",
    "@ai-sdk/anthropic": "1.1.6",
    "@ai-sdk/google": "1.1.0",
    "@ai-sdk/groq": "1.1.7",
    "@ai-sdk/mistral": "1.1.6",
    "@ai-sdk/openai": "1.1.9",
    "@electric-sql/pglite": "^0.2.17",
    "@fal-ai/client": "1.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "@types/uuid": "10.0.0",
    "ai": "4.1.16",
    "better-sqlite3": "11.8.1",
    "bignumber.js": "9.1.2",
    "dotenv": "16.4.5",
    "fastembed": "1.14.1",
    "glob": "11.0.0",
    "handlebars": "^4.7.8",
    "js-sha1": "0.7.0",
    "js-tiktoken": "1.0.15",
    "ollama-ai-provider": "0.16.1",
    "openai": "4.82.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sql.js": "^1.12.0",
    "together-ai": "0.7.0",
    "unique-names-generator": "4.7.1",
    "uuid": "11.0.3",
    "viem": "2.21.58",
    "vitest": "^3.0.5",
    "zod": "^3.24.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
