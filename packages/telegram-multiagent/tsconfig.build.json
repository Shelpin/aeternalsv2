{
  "extends": "../../tsconfig.build.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "dist",
    "composite": true,
    "paths": {
      "@elizaos/core/*": [
        "../core/src/*"
      ],
      "@elizaos/agent/*": [
        "../agent/src/*"
      ],
      "@elizaos/telegram-client/*": [
        "../clients/telegram/src/*"
      ]
    }
  },
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../agent"
    },
    {
      "path": "../clients/telegram"
    }
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/__tests__/**",
    "node_modules"
  ]
}