{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@elizaos/telegram-client": [
        "../clients/telegram/dist"
      ],
      "@elizaos/telegram-client/*": [
        "../clients/telegram/dist/*"
      ],
      "@elizaos/core": [
        "../core/dist"
      ],
      "@elizaos/core/*": [
        "../core/dist/*"
      ]
    },
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "__tests__",
    "**/*.test.ts",
    "src/plugin.ts"
  ]
}