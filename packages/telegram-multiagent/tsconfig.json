{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@elizaos/core": [
        "../core/src"
      ],
      "@elizaos/core/*": [
        "../core/src/*"
      ],
      "@elizaos/telegram-client": [
        "../clients/telegram/src"
      ],
      "@elizaos/telegram-client/*": [
        "../clients/telegram/src/*"
      ],
      "@elizaos/types": [
        "../types/src"
      ],
      "@elizaos/types/*": [
        "../types/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "**/*.test.ts"
  ]
}