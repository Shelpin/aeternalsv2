{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@elizaos/core": [
        "../core/dist"
      ],
      "@elizaos/core/*": [
        "../core/dist/*"
      ],
      "@elizaos/telegram-client": [
        "../clients/telegram/dist"
      ],
      "@elizaos/telegram-client/*": [
        "../clients/telegram/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "**/*.test.ts"
  ]
}