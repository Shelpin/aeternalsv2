{
  "name": "@elizaos/telegram-multiagent",
  "version": "0.1.0",
  "description": "Multi-agent coordination for Telegram bots in ElizaOS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0" 
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts-only=false",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "keywords": [
    "elizaos",
    "telegram",
    "multi-agent",
    "coordination",
    "ai"
  ],
  "author": "ElizaOS Team",
  "license": "MIT",
  "dependencies": {
    "@elizaos/core": "^0.25.9",
    "axios": "^1.6.2",
    "better-sqlite3": "^11.9.1",
    "sqlite": "^5.0.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "esbuild": "^0.20.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "@elizaos/core": "^0.25.9"
  }
}