{
  "name": "@elizaos/client-direct",
  "version": "0.25.9",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@types/body-parser": "1.19.5",
    "@types/cors": "2.8.17",
    "body-parser": "1.20.3",
    "cors": "2.8.5",
    "express": "4.21.1",
    "multer": "1.4.5-lts.1",
    "openai": "4.73.0",
    "path-to-regexp": "^1.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "^1.4.12",
    "rimraf": "^6.0.1",
    "tsup": "8.3.5"
  },
  "scripts": {
    "prebuild": "rimraf dist && find . -name '*.d.ts' -o -name '*.ts' | grep dist | xargs rm -f 2>/dev/null || true",
    "build": "tsup && cp index.d.ts dist/index.d.ts",
    "build:types": "cp index.d.ts dist/index.d.ts",
    "build:full": "pnpm build",
    "clean": "rimraf dist",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "whatwg-url": "7.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
