{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@elizaos/types": [
        "../types/dist"
      ],
      "@elizaos/core": [
        "../core/dist"
      ],
      "@elizaos/core/*": [
        "../core/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/node_modules/**"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../core"
    }
  ]
}