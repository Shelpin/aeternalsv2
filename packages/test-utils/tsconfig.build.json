{
    "extends": "../../tsconfig.build.base.json",
    "compilerOptions": {
        "baseUrl": "../..",
        "paths": {
            "@elizaos/core": [
                "packages/core/dist/public-api.d.ts"
            ]
        },
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "composite": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "references": [
        {
            "path": "../types"
        },
        {
            "path": "../core"
        }
    ]
}