{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@elizaos/core": [
        "../core/src"
      ]
    }
  },
  "references": [
    {
      "path": "../core"
    }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/__tests__/**",
    "node_modules"
  ]
}