{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@elizaos/types": [
        "../types/dist"
      ],
      "@elizaos/core": [
        "../core/dist"
      ],
      "@elizaos/core/*": [
        "../core/dist/*"
      ],
      "@elizaos/adapter-sqlite": [
        "../adapter-sqlite/dist"
      ],
      "@elizaos/adapter-sqlite/*": [
        "../adapter-sqlite/dist/*"
      ],
      "@elizaos/plugin-bootstrap": [
        "../plugin-bootstrap/dist"
      ],
      "@elizaos/plugin-bootstrap/*": [
        "../plugin-bootstrap/dist/*"
      ],
      "@elizaos/dynamic-imports": [
        "../dynamic-imports/dist"
      ],
      "@elizaos/dynamic-imports/*": [
        "../dynamic-imports/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/node_modules/**"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../core"
    },
    {
      "path": "../adapter-sqlite"
    },
    {
      "path": "../plugin-bootstrap"
    },
    {
      "path": "../dynamic-imports"
    }
  ]
}