{
  "extends": "../../tsconfig.build.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@elizaos/core": [
        "../core/src/index.ts"
      ],
      "@elizaos/plugin-bootstrap": [
        "../plugin-bootstrap/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/test_resources/**/*",
    "**/__tests__/**",
    "**/node_modules/**"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../core"
    },
    {
      "path": "../adapter-sqlite"
    },
    {
      "path": "../dynamic-imports"
    },
    {
      "path": "../plugin-bootstrap"
    },
    {
      "path": "../telegram-multiagent/tsconfig.build.json"
    },
    {
      "path": "../client-direct/tsconfig.build.json"
    }
  ]
}