{
  "compilerOptions": {
    "target": "ES2021",
    "module": "nodenext",
    "lib": [
      "es2021",
      "dom"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "baseUrl": ".",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "composite": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "*": [
        "src/*"
      ]
    },
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ]
}