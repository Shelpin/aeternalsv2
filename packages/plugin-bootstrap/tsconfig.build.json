{
  "extends": "../../tsconfig.build.base.json",
  "compilerOptions": {
    "strict": false,
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/test_resources/**/*",
    "**/__tests__/**"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../core"
    }
  ]
}